<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WSI.Goat.IntershipsContracts.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light mb-3 card-nav c-blue">
            <div class="container-fluid">
                <a class="navbar-brand text-uppercase fw-bolder" asp-area="" asp-controller="Home" asp-action="Index">S-Tool</a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("StudentName")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark text-uppercase"
                                   asp-area="Student"
                                   asp-controller="Student"
                                   asp-action="Logout">Log out as student</a>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("MentorName")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark text-uppercase"
                                   asp-area="Mentor"
                                   asp-controller="Mentor"
                                   asp-action="Logout">Log out as mentor</a>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("SupervisorName")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark text-uppercase"
                                   asp-area="Supervisor"
                                   asp-controller="Supervisor"
                                   asp-action="Logout">Log out as supervisor</a>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("CoordinatorName")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark text-uppercase"
                                   asp-area="Coordinator"
                                   asp-controller="Coordinator"
                                   asp-action="Logout">Log out as coordinator</a>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("AdminName")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark text-uppercase"
                                   asp-area="Admin"
                                   asp-controller="Admin"
                                   asp-action="Logout">Log out as admin</a>
                            </li>
                        }
                    </ul>
                </div>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">

                    @if (string.IsNullOrEmpty(Context.Session.GetString("AdminName")))
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-dark text-uppercase fw-bold border border-dark border-3"
                                   asp-area="Admin"
                                   asp-controller="Admin"
                                   asp-action="Login">
                                    Admin
                                </a>
                            </li>
                        </ul>
                    }

                </div>
                
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!--
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WSI.Goat.IntershipsContracts.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
