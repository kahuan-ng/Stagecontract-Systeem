@model CoordinatorIndexViewModel

@{
    Layout = "~/Areas/Coordinator/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h4 class="fw-bold">Welkom, @Model.CoordinatorName <strong>@Model.Contracts.Count</strong> student(en) heeft een contract.</h4>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="card-field rounded-0 p-4 p-md-5">
                <div class="my-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0 m-0">
                        Toegewezen Stagiairs
                    </span>
    
                    <a asp-area="Coordinator" 
                       asp-controller="Coordinator" 
                       asp-action="Search" 
                       class="btn card-button-badge c-blue text-uppercase fw-bold d-inline-block px-3 rounded-0">
                        Zoek een student
                    </a>
                </div>

                @if (!Model.Contracts.Any())
                {
                    <div class="alert card-field c-red text-uppercase fw-bolder rounded-0 my-4">
                        Er zijn momenteel geen actieve of ingevulde stagecontracten aan jou gekoppeld
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle card-cel">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col">Student</th>
                                    <th scope="col">E-mail</th>
                                    <th scope="col">Telefoon</th>
                                    <th scope="col">Organisatie</th>
                                    <th scope="col">Mail</th>
                                    <th scope="col">Status contract</th>
                                    <th scope="col">Vervolledig contract</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.Contracts)
                                {
                                    <tr class="form-tr">
                                        <td>@student.StudentName</td>

                                        <td>
                                            <a asp-area="Coordinator"
                                               asp-controller="Coordinator"
                                               asp-action="ViewStudentContract"
                                               asp-route-id="@student.ContractId"
                                               class="text-decoration-underline text-dark fw-bolder">
                                                @student.StudentEmail
                                            </a>
                                        </td>
                                        <td>@student.StudentTelephoneNumber</td>
                                        <td>@student.StudentRepresentedOrganisation</td>
                                        <td>@student.OrganizationEmail</td>
                                        <td>
                                            @if (student.IsSigned)
                                            {
                                                <span class="card-badge c-green text-decoration-none text-black">
                                                    Gekeurd
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="card-badge c-red text-decoration-none text-black">
                                                    Niet gekeurd
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-area="Coordinator" 
                                               asp-controller="Coordinator" 
                                               asp-action="EditStudentContract" 
                                               asp-route-id="@student.ContractId" 
                                               class="card-button-badge c-blue text-decoration-none text-black">Wijzig contract
                                                </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>