@model WSI.Goat.InternshipContracts.Web.Areas.Supervisor.ViewModels.SupervisorCompleteContractViewModel

@{
    ViewData["Title"] = "Vervolledig contract";
    bool isSigned = Model.SupervisourIsSigned;
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-black fw-bolder text-uppercase mb-2">
            @ViewBag.Title
        </h1>
        <p class="fw-light">Pas de nodige contractgegevens aan en vul aan voor verzending naar de coördinator van howest.</p>
    </div>

    <form asp-area="Supervisor" 
          asp-controller="Supervisor" 
          asp-action="CompleteContract" 
          method="post" 
          class="row g-4 justify-content-center" 
          enctype="multipart/form-data">
        <input type="hidden" asp-for="ContractId" />
        <input type="hidden" asp-for="HasRiskAnalysis" />

        <div class="col-lg-12">
            <div class="bg-white card-field rounded-0 p-4 p-md-5">
                
                <div class="row g-4 mb-5">
                    <div class="col-md-4 text-center">
                        <div class="card-cel rounded-0 h-100 d-flex flex-column justify-content-center align-items-center @(Model.StudentIsSigned ? "c-green" : "c-red")">
                            <span class="text-uppercase fw-black small d-block mb-1">Student handtekening</span>
                            <span class="h4 fw-bolder text-uppercase m-0">@(Model.StudentIsSigned ? "Getekend" : "Ongetekend")</span>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="card-cel rounded-0 h-100 d-flex flex-column justify-content-center align-items-center @(Model.MentorIsSigned ? "c-green" : "c-red")">
                            <span class="text-uppercase fw-black small d-block mb-1">Mentor handtekening</span>
                            <span class="h4 fw-bolder text-uppercase m-0">@(Model.MentorIsSigned ? "Getekend" : "Ongetekend")</span>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="card-cel rounded-0 h-100 d-flex flex-column justify-content-center align-items-center @(Model.SupervisourIsSigned ? "c-green" : "c-red")">
                            <span class="text-uppercase fw-black small d-block mb-1">Supervisour Handtekening</span>
                            <span class="h4 fw-bolder text-uppercase m-0">@(Model.SupervisourIsSigned ? "Getekend" : "Ongetekend")</span>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="card-cel rounded-0 h-100 d-flex flex-column justify-content-center align-items-center @(Model.CoordinatorValidation ? "c-green" : "c-red")">
                            <span class="text-uppercase fw-black small d-block mb-1">Coordinator validatie</span>
                            <span class="h4 fw-bolder text-uppercase m-0">@(Model.CoordinatorValidation ? "Gekeurd" : "Niet gekeurd")</span>
                        </div>
                    </div>

                    @if (Model.HasRiskAnalysis)
                    {
                        @if (Model.RiskAnalysis != null)    
                        {
                            <div class="col-md-4 text-center">
                                <div class="card-cel rounded-0 h-100 d-flex flex-column justify-content-center align-items-center @(Model.HasRiskAnalysis ? "c-blue" : "c-red")">
                                    <span class="text-uppercase fw-black small d-block mb-1">Risicoanalyse</span>
                                    <span class="h4 fw-bolder text-uppercase m-0">@(Model.HasRiskAnalysis ? "Nodig" : "Ontbreekt")</span>
                                </div>
                            </div>
                        
                            }

                            else 
                            {
                            <div class="col-md-4 text-center">
                                <div class="card-cel rounded-0 h-100 d-flex flex-column justify-content-center align-items-center @(Model.HasRiskAnalysis ? "c-green" : "c-red")">
                                    <span class="text-uppercase fw-black small d-block mb-1">Risicoanalyse</span>
                                    <span class="h4 fw-bolder text-uppercase m-0">@(Model.HasRiskAnalysis ? "Aanwezig" : "Ontbreekt")</span>
                                </div>
                            </div>
                        }
                    }

                    else
                    {
                        <div class="col-md-4 text-center">
                            <div class="card-cel rounded-0 h-100 d-flex flex-column justify-content-center align-items-center @(Model.HasRiskAnalysis ? "c-green" : "c-red")">
                                <span class="text-uppercase fw-black small d-block mb-1">Risicoanalyse</span>
                                <span class="h4 fw-bolder text-uppercase m-0">@(Model.HasRiskAnalysis ? "Aanwezig" : "Ontbreekt")</span>
                            </div>
                        </div>
                    }

                    <div class="col-md-4 text-center">
                        <div class="card-cel rounded-0 h-100 d-flex flex-column justify-content-center align-items-center @(Model.NeedsMedical ? "c-green" : "c-blue")">
                            <span class="text-uppercase fw-black small d-block mb-1">Medisch Attest</span>
                            <span class="h4 fw-bolder text-uppercase m-0">@(Model.NeedsMedical ? "Vereist" : "Niet Vereist")</span>
                        </div>
                    </div>
                </div>

                <div class="my-4">
                    <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0">
                        Algemene Informatie
                    </span>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-12">
                        <div class="card-cel rounded-0 bg-light">
                            <span class="text-uppercase small fw-bold d-block mb-2">Contract Titel</span>
                            <span asp-validation-for="ContractTitle" class="text-danger text-uppercase small mb-1 d-block"></span>
                            <input asp-for="ContractTitle" 
                                   disabled="@isSigned"
                                   class="form-control rounded-0 fw-bolder h5 m-0" 
                                   placeholder="Contract Titel"/>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card-cel rounded-0 bg-light h-100 opacity-75">
                            <span class="text-uppercase small fw-bold text-muted d-block">Opleiding</span>
                            <span class="fw-bolder h5 text-secondary">@Model.DepartmentName</span>
                        </div>    
                    </div>
                    <div class="col-md-6">
                        <div class="card-cel rounded-0 bg-light h-100 opacity-75">
                            <span class="text-uppercase small fw-bold text-muted d-block">Type Stage</span>
                            <span class="fw-bolder h5 text-secondary">@Model.InternshipTypeName</span>
                        </div>  
                    </div>
                    <div class="col-md-6">
                        <div class="card-cel rounded-0 bg-light">
                            <span class="text-uppercase small fw-bold d-block mb-2">Startdatum</span>
                            <span asp-validation-for="StartDate" class="text-danger text-uppercase small mb-1 d-block"></span>
                            <input asp-for="StartDate" 
                                   disabled="@isSigned"
                                   class="form-control rounded-0 fw-bolder h5 m-0" />
                        </div>  
                    </div>    
                    <div class="col-md-6">
                        <div class="card-cel rounded-0 bg-light">
                            <span class="text-uppercase small fw-bold d-block mb-2">Einddatum</span>
                            <span asp-validation-for="EndDate" class="text-danger text-uppercase small mb-1 d-block"></span>
                            <input asp-for="EndDate" 
                                   disabled="@isSigned"
                                   class="form-control rounded-0 fw-bolder h5 m-0" />
                        </div>  
                    </div>            
                </div>

                <div class="my-4">
                    <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0">
                        Gegevens Student
                    </span>
                </div>

                <div class="row g-4 border-3 border-dark mb-5">
                    <div class="col-md-4">
                        <div class="card-cel rounded-0 bg-light h-100 opacity-75">
                            <span class="text-uppercase small fw-bold text-muted d-block">Naam Student</span>
                            <span class="fw-bolder h6 text-secondary">@Model.StudentName</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card-cel rounded-0 bg-light h-100 opacity-75">
                            <span class="text-uppercase small fw-bold text-muted d-block">E-mailadres</span>
                            <span class="fw-bolder h6 text-secondary">@Model.StudentEmail</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card-cel rounded-0 bg-light h-100 opacity-75">
                            <span class="text-uppercase small fw-bold text-muted d-block">Telefoonnummer</span>
                            <span class="fw-bolder h6 text-secondary">@Model.StudentPhone</span>
                        </div>
                    </div>
                </div>

                <div class="my-4">
                    <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0">
                        Stage Adres Gegevens
                    </span>
                </div>

                <div class="row border-3 border-dark mb-3">
                    <div class="col-md-8">
                        <div class="card-cel rounded-0">
                            <span class="text-uppercase small fw-bold d-block mb-2">Straat</span>
                            <span asp-validation-for="InternshipStreet" class="text-danger text-uppercase small mb-1 d-block"></span>
                            <input asp-for="InternshipStreet" 
                                   disabled="@isSigned"
                                   class="form-control rounded-0 fw-bolder h5 m-0" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card-cel rounded-0">
                            <span class="text-uppercase small fw-bold d-block mb-2">Huisnummer</span>
                            <span asp-validation-for="InternshipStreetNumber" class="text-danger text-uppercase small mb-1 d-block"></span>
                            <input asp-for="InternshipStreetNumber" 
                                   disabled="@isSigned"
                                   class="form-control rounded-0 fw-bolder h5 m-0" />
                        </div>
                    </div>
                </div>
                
                <div class="row border-3 border-dark mb-5">
                    <div class="col-md-4">
                        <div class="card-cel rounded-0">
                            <span class="text-uppercase small fw-bold d-block mb-2">Postcode</span>
                            <span asp-validation-for="InternshipPostalCode" class="text-danger text-uppercase small mb-1 d-block"></span>
                            <input asp-for="InternshipPostalCode" 
                                   disabled="@isSigned"
                                   class="form-control rounded-0 fw-bolder h5 m-0" />
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="card-cel rounded-0">
                            <span class="text-uppercase small fw-bold d-block mb-2">Gemeente</span>
                            <span asp-validation-for="InternshipMunicipality" class="text-danger text-uppercase small mb-1 d-block"></span>
                            <input asp-for="InternshipMunicipality" 
                                   disabled="@isSigned"
                                   class="form-control rounded-0 fw-bolder h5 m-0" />
                        </div>
                    </div>
                </div>

                <div class="my-4">
                    <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0">
                        Opmerkingen
                    </span>
                </div>

                <div class="row mb-5">
                    <div class="col-md-12">
                        <div class="card-cel rounded-0">
                            <span asp-validation-for="InternshipCoordinatorRemarks" class="text-danger text-uppercase small mb-1 d-block"></span>
                            <textarea asp-for="InternshipCoordinatorRemarks" disabled class="form-control rounded-0 w-100" rows="4" placeholder="Er zijn momenteel geen opmerkingen van Howest."></textarea>
                        </div>
                    </div>
                </div>

                <div class="my-4">
                    <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0">
                        Medische Onderzoek
                    </span>
                </div>

                <div class="form-check form-switch my-5 p-0 d-flex align-items-center">
                    <input asp-for="NeedsMedical" type="checkbox" class="form-check-input border-3 border-dark m-0 me-3 rounded-0" id="medicalSwitch" style="width: 3em; height: 1.5em; cursor: pointer;" />
                    <label asp-for="NeedsMedical" class="form-check-label text-uppercase fw-bolder h6 m-0" for="medicalSwitch" style="cursor: pointer;"></label>
                </div>


                @if (Model.SupervisourIsSigned == false)
                {
                    <div class="my-4">
                        <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0">
                            Handtekening
                        </span>
                    </div>

                    <div class="row mb-5">
                        <div class="col-md-12">
                            <div class="card-cel rounded-0 bg-light">
                                <span asp-validation-for="SupervisourSignature" class="text-danger text-uppercase small mb-1 d-block"></span>
                                <input asp-for="SupervisourSignature" class="form-control rounded-0" />
                            </div>
                        </div>
                    </div>
                }

                    
                @if (Model.HasRiskAnalysis)
                {
                    <div class="my-4">
                        <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0">
                            RisicoAnalyse
                        </span>
                        <div class="card-cel rounded-0 bg-light">
                            <a asp-action="DownloadRiskAnalysis" class="btn card-button rounded-0 text-uppercase px-5 py-3 fw-bold text-decoration-none">
                                Download
                            </a>
                        </div>
                    </div>

                    <div class="row mb-5">
                        <div class="col-md-12">
                            <div class="card-cel rounded-0 bg-light">
                                <span class="text-uppercase small fw-bold text-muted d-block mb-2">Upload RisicoAnalyse (PDF)</span>
                                <input type="file" name="riskAnalysis" class="form-control rounded-0" accept="application/pdf" />
                            </div>
                        </div>
                    </div>

                }

                <div class="d-flex justify-content-center gap-3 pt-3">
                    <a asp-area="Supervisor" asp-controller="Supervisor" asp-action="Index" 
                       class="btn card-button rounded-0 text-uppercase px-5 py-3 fw-bold text-decoration-none">
                        Terug naar overzicht
                    </a>
                    
                    @if (!Model.SupervisourIsSigned)
                    {
                        <button type="submit" class="btn card-button rounded-0 text-uppercase px-5 py-3 fw-bold">
                            Gegevens Opslaan & Doorsturen
                        </button>
                    }
                </div>
            </div>
        </div>
    </form>
</div>