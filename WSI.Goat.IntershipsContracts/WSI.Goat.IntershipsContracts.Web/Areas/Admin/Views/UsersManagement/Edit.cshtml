@model UserCreateEditViewModel

@{
    ViewData["Title"] = "Gebruiker bewerken";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-black fw-bolder text-uppercase mb-2">
            @ViewBag.Title
        </h1>
        <p class="fw-bold">Pas de onderstaande gegevens aan om het profiel og de rechten van de gebruiker bij te werken.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="bg-white card-field rounded-0">

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="All" class="text-danger mb-4 fw-bold"></div>
                    
                    <input asp-for="Id" type="hidden" />

                    <div class="row">
                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="FirstName" class="form-label text-uppercase fw-bolder h6">Voornaam</label>
                            <input asp-for="FirstName" class="form-control form-control-lg rounded-0 border-3 border-dark" />
                            <span asp-validation-for="FirstName" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="LastName" class="form-label text-uppercase fw-bolder h6">Achternaam</label>
                            <input asp-for="LastName" class="form-control form-control-lg rounded-0 border-3 border-dark" />
                            <span asp-validation-for="LastName" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="Email" class="form-label text-uppercase fw-bolder h6">E-mail</label>
                            <input asp-for="Email" class="form-control form-control-lg rounded-0 border-3 border-dark" />
                            <span asp-validation-for="Email" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="Password" class="form-label text-uppercase fw-bolder h6">Wachtwoord</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg rounded-0 border-3 border-dark" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="my-4">
                        <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0">
                            Functie & Rechten
                        </span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="Function" class="form-label text-uppercase fw-bolder h6">Functie</label>
                            <input asp-for="Function" class="form-control form-control-lg rounded-0 border-3 border-dark" />
                            <span asp-validation-for="Function" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="TelephoneNumber" class="form-label text-uppercase fw-bolder h6">Telefoonnummer</label>
                            <input asp-for="TelephoneNumber" class="form-control form-control-lg rounded-0 border-3 border-dark" />
                            <span asp-validation-for="TelephoneNumber" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="form-group mb-5">
                        <label asp-for="SelectedRoleId" class="form-label text-uppercase fw-bolder h6">Platform Rol</label>
                        <select asp-for="SelectedRoleId" asp-items="Model.Roles" class="form-select form-select-lg rounded-0 border-3 border-dark">
                            <option value="">-- Selecteer rol --</option>
                        </select>
                        <span asp-validation-for="SelectedRoleId" class="text-danger fw-bold small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-between gap-4 pt-3">
                        <a asp-area="Admin" asp-controller="UsersManagement" asp-action="Index" 
                           class="btn card-button-badge fw-bold text-uppercase py-3 px-4 text-center text-decoration-none rounded-0">
                            Terug naar overzicht
                        </a>
                        <button type="submit" class="btn card-button-badge fw-bold text-uppercase py-3 px-5 rounded-0">
                            Opslaan
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>