@model AdminIndexViewModel

@{
    ViewData["Title"] = "ADMIN";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-black fw-bolder text-uppercase mb-2">
            @ViewBag.Title
        </h1></div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="bg-white card-field rounded-0">
                
                <div class="my-3 text-center">
                    <span class="card-badge c-yellow text-uppercase fw-bolder h6 d-inline-block px-3 py-2 rounded-0 mb-4">
                        Beheermodules
                    </span>
                </div>

                <div class="d-flex flex-column gap-4">
                    <a class="btn card-button-badge fw-bold text-uppercase py-3 px-4 text-center text-decoration-none"
                       asp-area="Admin"
                       asp-controller="UsersManagement"
                       asp-action="Index">
                        Gebruikersbeheer
                    </a>

                    <a class="btn card-button-badge fw-bold text-uppercase py-3 px-4 text-center text-decoration-none"
                       asp-area="Admin"
                       asp-controller="Cluster"
                       asp-action="Index">
                        Clusters
                    </a>

                    <a class="btn card-button-badge fw-bold text-uppercase py-3 px-4 text-center text-decoration-none"
                       asp-area="Admin"
                       asp-controller="Department"
                       asp-action="Index">
                        Departementen
                    </a>

                    <a class="btn card-button-badge fw-bold text-uppercase py-3 px-4 text-center text-decoration-none"
                       asp-area="Admin"
                       asp-controller="InternshipType"
                       asp-action="Index">
                        Stagetypes
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>