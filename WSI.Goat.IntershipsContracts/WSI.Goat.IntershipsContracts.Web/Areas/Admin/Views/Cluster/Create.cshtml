@model ClusterOverviewViewModel

@{
    ViewData["Title"] = "Cluster aanmaken";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-black fw-bolder text-uppercase mb-2">
            @ViewBag.Title
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="bg-white card-field rounded-0">

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4 fw-bold"></div>

                    <div class="form-group mb-5">
                        <label asp-for="BaseName" class="form-label text-uppercase fw-bolder h6">Cluster naam</label>
                        <input asp-for="BaseName" class="form-control form-control-lg rounded-0 border-3 border-dark" />
                        <span asp-validation-for="BaseName" class="text-danger fw-bold small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-between gap-4 pt-3">
                        <a asp-area="Admin" asp-controller="Cluster" asp-action="Index" 
                           class="btn card-button-badge fw-bold text-uppercase py-3 px-4 text-center text-decoration-none rounded-0">
                            Terug naar overzicht
                        </a>
                        <button type="submit" class="btn card-button-badge fw-bold text-uppercase py-3 px-5 rounded-0">
                            Opslaan
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>