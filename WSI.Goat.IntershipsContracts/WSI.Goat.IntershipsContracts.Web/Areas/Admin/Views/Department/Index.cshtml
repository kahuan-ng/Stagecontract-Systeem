@model DepartmentIndexViewModel

@{
    ViewData["Title"] = "Departementen";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-black fw-bolder text-uppercase mb-2">
            @ViewBag.Title
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="bg-white card-field rounded-0">
                
                <div class="d-flex flex-column flex-md-row justify-content-between gap-4 mb-4">
                    <a class="btn card-button-badge fw-bold text-uppercase py-3 px-4 text-center text-decoration-none rounded-0"
                       asp-area="Admin"
                       asp-controller="Admin"
                       asp-action="Index">
                        Terug naar dashboard
                    </a>
                    
                    <a class="btn card-button-badge fw-bold text-uppercase py-3 px-4 text-center text-decoration-none rounded-0"
                       asp-action="Create">
                        Departementen aanmaken
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered border-3 border-dark mb-0 align-middle text-dark rounded-0">
                        <thead class="c-yellow text-uppercase">
                            <tr class="border-bottom border-3 border-dark">
                                <th class="py-3 px-4 fw-bold mb-0 text-dark border-end border-3 border-dark">Departement</th>
                                <th class="py-3 px-4 fw-bold mb-0 text-dark border-end border-3 border-dark">Locatie</th>
                                <th class="py-3 px-4 fw-bold mb-0 text-dark border-end border-3 border-dark">Cluster</th>
                                <th class="py-3 px-4 fw-bold mb-0 text-dark border-end border-3 border-dark">Stagecoördinator</th>
                                <th class="py-3 px-4 fw-bold mb-0 text-dark text-center" style="width: 150px;">Acties</th>
                            </tr>
                        </thead>
                        <tbody class="fw-bold">
                            @foreach (var d in Model.Departments.OrderBy(dept => dept.BaseName).ThenBy(dept => dept.Location))
                            {
                                <tr class="border-bottom border-3 border-dark">
                                    <td class="py-3 px-4 border-end border-3 border-dark">@d.BaseName</td>
                                    <td class="py-3 px-4 border-end border-3 border-dark">@d.Location</td>
                                    <td class="py-3 px-4 border-end border-3 border-dark">@d.ClusterName</td>
                                    <td class="py-3 px-4 border-end border-3 border-dark">@d.StageCoordinatorName</td>
                                    <td class="py-3 px-4 text-center">
                                        <a class="btn card-button-badge btn-sm fw-bold text-uppercase py-2 px-3 text-center text-decoration-none d-inline-block rounded-0"
                                           asp-action="Edit"
                                           asp-route-id="@d.Id">
                                            Bewerken
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>