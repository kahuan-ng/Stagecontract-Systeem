@model DepartmentCreateEditViewModel

@{
    ViewData["Title"] = "Departement aanmaken";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-black fw-bolder text-uppercase mb-2">
            @ViewBag.Title
        </h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="bg-white card-field rounded-0">

                <form asp-area="Admin" asp-controller="Department" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4 fw-bold"></div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="BaseName" class="form-label text-uppercase fw-bolder h6">Departement</label>
                            <input asp-for="BaseName" class="form-control form-control-lg rounded-0 border-3 border-dark" />
                            <span asp-validation-for="BaseName" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="Location" class="form-label text-uppercase fw-bolder h6">Locatie</label>
                            <input asp-for="Location" class="form-control form-control-lg rounded-0 border-3 border-dark" />
                            <span asp-validation-for="Location" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="ClusterId" class="form-label text-uppercase fw-bolder h6">Cluster</label>
                            <select asp-for="ClusterId" asp-items="Model.Clusters" class="form-select form-select-lg rounded-0 border-3 border-dark">
                                <option value="">-- selecteer cluster --</option>
                            </select>
                            <span asp-validation-for="ClusterId" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="StageCoordinatorId" class="form-label text-uppercase fw-bolder h6">Stagecoördinator</label>
                            <select asp-for="StageCoordinatorId" asp-items="Model.StageCoordinators" class="form-select form-select-lg rounded-0 border-3 border-dark">
                                <option value="">Stagecoördinator</option>
                            </select>
                            <span asp-validation-for="StageCoordinatorId" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-between gap-4 pt-3 mt-4">
                        <a asp-area="Admin" asp-controller="Department" asp-action="Index" 
                           class="btn card-button-badge fw-bold text-uppercase py-3 px-4 text-center text-decoration-none rounded-0">
                            Annuleren
                        </a>
                        <button type="submit" class="btn card-button-badge fw-bold text-uppercase py-3 px-5 rounded-0">
                            Opslaan
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>