@model StudentLoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="text-center py-5 mt-5">
    <h1 class="display-5 fw-black fw-bolder text-uppercase">
        @ViewBag.Title Student
    </h1>
    <p></p>
</div>

<form asp-controller="Student"
      asp-action="Login"
      method="Post" enctype="multipart/form-data"
      class="py-1 mb-5 text-center">
        
    <div asp-validation-summary="ModelOnly" 
         class="text-danger text-uppercase small mb-3"></div>
        
    <div class="text-center mb-3">
        <span asp-validation-for="Email"
              class="text-danger text-uppercase small"></span>
    </div>

    <div class="mb-3 mx-auto w-50">
        <input asp-for="Email"
               class="form-control rounded-0 mb-2 card-field mb-4"
               placeholder="Email"/>
    </div>

    <div class="text-center mb-3">
        <span asp-validation-for="Password"
              class="text-danger text-uppercase small"></span>
    </div>

    <div class="mb-3 mx-auto w-50">
        <input asp-for="Password"
               type="password"
               class="form-control rounded-0 mb-2 card-field mb-4"
               placeholder="Wachtwoord"/>
    </div>

    <div class="text-center mb-5">
        <button type="submit"
                class="btn btn-dark rounded-0 text-uppercase m-1 px-4 py-2 fw-light card-button">
            Login
        </button>
    </div>
</form>
  