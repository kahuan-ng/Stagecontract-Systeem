@model StudentIndexViewModel

<div class="container mt-4">
    
    @if(TempData.ContainsKey("ContractSend"))
    {
        <div class="alert card-badge c-blue text-uppercase fw-bolder rounded-0 my-4">
            <span>@TempData["ContractSend"]</span>
        </div>
    }
    
    <div class="text-center mb-5">
        <h4 class="fw-bold">Welkom, @Model.StudentName</h4>
    </div>

    <div class="card-field rounded-0 p-4 p-md-5">
    @if (!Model.Contracts.Any())
    {
        <div class="alert card-field c-red text-uppercase fw-bolder">
            Je hebt momenteel nog geen stagecontracten ingevuld.
        </div>

        <div class="mt-5">
            <a asp-area="Student"
               asp-controller="Student"
               asp-action="AddContract"
               class="btn card-button c-yellow text-uppercase fw-bold">
                Vul een stagecontract in
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle card-cel">
                <thead class="table-dark">
                <tr>
                    <th>Periode</th>
                    <th>Contract Naam</th>
                    <th>Locatie (Gemeente)</th>
                    <th>Status</th>
                </tr>
                </thead>
                
                <tbody>
                    @foreach (var contract in Model.Contracts)
                    {
                        <tr class="form-tr">
                            <td>
                                @contract.StartDate.ToString("dd/MM/yyyy") - @contract.EndDate.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <a asp-action="ShowContractDetails" 
                                   asp-route-id="@contract.InternshipContractId"
                                   class="d-block fw-bolder text-dark text-decoration-underline h6 m-0">
                                    @contract.InternshipContractName
                                </a>
                            </td>
                            <td>
                                @contract.InternshipMunicipality
                            </td>
                            <td>
                                @if (contract.SupervisourIsSigned && contract.MentorIsSigned)
                                {
                                    <span class="card-badge c-green">Getekend</span>
                                }
                                else
                                {
                                    <span class="card-badge c-red">Nog te tekenen door stage plaats en mentor</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
</div>